{
  "name": "circulaw",
  "version": "2.1.0",
  "description": "regelgeving voor een circulaire economie",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:staging": "env-cmd -e staging next dev",
    "dev:prod": "env-cmd -e production next dev",
    "cms:staging": "env-cmd -e staging concurrently \"next dev\" \"cd studio && yarn && yarn dev:staging\"",
    "cms:dev": "env-cmd -e dev concurrently \"next dev\" \"cd studio && yarn && yarn dev:dev\"",
    "cms:prod": "env-cmd -e production concurrently \"next dev\" \"cd studio && yarn && yarn dev:prod\"",
    "prebuild": "echo 'Building Sanity to public/studio' && cd studio && yarn && npx @sanity/cli build ../public/studio -y && echo 'Done'",
    "build": "next build",
    "build:staging": "env-cmd -e staging next build",
    "build:prod": "env-cmd -e production next build",
    "start": "next start",
    "clean": "prettier --write \"(pages|components|studio|lib|app)/**/*.+(js|jsx|json|css|md)\" --config ./prettier.config.js",
    "lint": "eslint .",
    "prepare": "husky",
    "pre-commit": "eslint --fix ."
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@headlessui/react": "^2.2.10",
    "@lottiefiles/react-lottie-player": "^3.6.0",
    "@portabletext/react": "^8.0.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@react-spring/web": "^9.7.5",
    "@sanity/asset-utils": "^1.3.2",
    "@sanity/image-url": "^1.0.1",
    "@tabler/icons-react": "^3.46.0",
    "@tailwindcss/forms": "^0.5.11",
    "@vercel/og": "^0.8.6",
    "algoliasearch": "^4.27.0",
    "axios": "^1.20.0",
    "cookies-next": "^4.3.0",
    "next": "16.3.4",
    "next-sanity": "^13.3.4",
    "next-sanity-image": "^6.2.0",
    "next-share": "0.27.0",
    "next-sitemap": "^4.2.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^4.7.1",
    "react-instantsearch": "^7.49.0",
    "react-instantsearch-nextjs": "^1.4.8",
    "react-player": "^2.16.1",
    "react-scroll": "^1.9.3",
    "react-social-icons": "^6.26.0",
    "sanity-algolia": "^1.1.0",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "autoprefixer": "^10.5.6",
    "concurrently": "^7.6.0",
    "env-cmd": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3"
  },
  "resolutions": {
    "caniuse-lite": "^1.0.30001810",
    "postcss": "^8.5.28"
  }
}
